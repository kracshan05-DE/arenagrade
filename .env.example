# ArenaGrade environment variables. Copy to .env.local for local development.
# In Vercel, set these under Project -> Settings -> Environment Variables, with
# separate values for Production and Preview. Never commit real values.

# --- Public (shipped to the browser; NOT secrets) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server only --------------------------------------------------------------
# Canonical site URL used in PayHere return/notify URLs and links (https in production).
APP_BASE_URL=https://arenagrade.lk
# Supabase service role key (Project Settings -> API). Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Random string, at least 32 characters. Keys the OTP and IP hashes.
OTP_HASH_SECRET=
# Random string, at least 16 characters. Vercel sends it to the cron endpoint.
CRON_SECRET=

# SMS (Text.lk)
TEXT_LK_API_KEY=
TEXT_LK_SENDER_ID=TextLKDemo
# Maximum OTP codes issued per day across the site (spend cap).
SMS_OTP_DAILY_CAP=300
# Owner/admin phone: receives cancellation requests.
ADMIN_ALERT_PHONE=07XXXXXXXX
# WhatsApp number customers send bank details to for refunds.
REFUND_WHATSAPP_NUMBER=07XXXXXXXX
# Comma-separated phones for CRITICAL technical alerts (independent of email).
CRITICAL_ALERT_PHONES=07XXXXXXXX

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=ArenaGrade <onboarding@resend.dev>
# Daily 10 PM report recipients, comma-separated.
REPORT_RECIPIENTS=owner@gmail.com,admin@gmail.com

# PayHere. Use SANDBOX credentials in Preview, LIVE credentials only in Production.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# --- Non-production testing only (the build fails if enabled in production) ----
# PAYMENT_SIMULATION=enabled
# OTP_TEST_MODE=enabled
